{
  "name": "siftbar",
  "version": "0.1.0",
  "description": "A framework-free, typed filter bar for the web.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/siftbar.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/siftbar.js"
    },
    "./browser": "./dist/siftbar.browser.js",
    "./styles.css": "./dist/styles.css",
    "./base.css": "./dist/base.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "dev": "npm run build:site && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests examples scripts site/*.js",
    "test": "npm run build && vitest run",
    "test:browser": "npm run build:site && node scripts/build-test-fixtures.mjs && playwright test",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:browser && npm run check:package",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.0",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^8.0.23",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.4"
  }
}
